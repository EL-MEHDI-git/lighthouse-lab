# =============================================================================
# Lighthouse Lab — modèle de configuration
# Copiez ce fichier en `.env` puis adaptez les valeurs :
#     cp .env.example .env
# `.env` est ignoré par git et ne doit JAMAIS être commité.
# =============================================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lighthouse
DB_USER=lighthouse
DB_PASSWORD=change_me

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=admin@lighthouse.dev
PGADMIN_PASSWORD=change_me

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Application ---
LOG_LEVEL=INFO

# --- Optionnel : déplacer le cache Hugging Face (4,3 Go pour bge-m3) ---
# HF_HOME=/chemin/vers/mon/cache
